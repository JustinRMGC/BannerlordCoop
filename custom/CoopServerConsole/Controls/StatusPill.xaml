<!-- FONZA-CUSTOM · reusable status pill: colored dot + label, tinted by Kind. -->
<UserControl x:Class="CoopServerConsole.StatusPill"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="root">
    <Border CornerRadius="11" Padding="9,3" SnapsToDevicePixels="True"
            Background="{Binding Kind, ElementName=root, Converter={StaticResource StatusBrush}, ConverterParameter=bg}"
            BorderBrush="{Binding Kind, ElementName=root, Converter={StaticResource StatusBrush}, ConverterParameter=border}"
            BorderThickness="1">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Ellipse Width="7" Height="7" Margin="0,0,7,0" VerticalAlignment="Center"
                     Fill="{Binding Kind, ElementName=root, Converter={StaticResource StatusBrush}, ConverterParameter=dot}"/>
            <TextBlock Text="{Binding Text, ElementName=root}" VerticalAlignment="Center"
                       FontFamily="{StaticResource FontText}" FontSize="12" FontWeight="SemiBold"
                       Foreground="{Binding Kind, ElementName=root, Converter={StaticResource StatusBrush}, ConverterParameter=text}"/>
        </StackPanel>
    </Border>
</UserControl>
