<UserControl x:Class="CoopServerConsole.Views.PlaceholderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440">
            <TextBlock Style="{StaticResource Text.Title}" Text="{Binding Title}" HorizontalAlignment="Center" Margin="0,0,0,10"/>
            <TextBlock Style="{StaticResource Text.Secondary}" Text="{Binding Message}" TextAlignment="Center" TextWrapping="Wrap"/>
        </StackPanel>
    </Grid>
</UserControl>
