<UserControl x:Class="CoopServerConsole.Views.LogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:CoopServerConsole"
             xmlns:views="clr-namespace:CoopServerConsole.Views">
    <UserControl.Resources>
        <views:BoolToWrapConverter x:Key="BoolToWrap"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===================== TOOLBAR ===================== -->
        <Grid Grid.Row="0" Height="34" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- search (icon prefix + watermark, keeps the Field style intact) -->
            <Grid Grid.Column="0" Width="240" VerticalAlignment="Center">
                <TextBox Style="{StaticResource Field}" Padding="32,0,10,0"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="{StaticResource Icon.Search}" FontFamily="{StaticResource FontIcon}"
                           FontSize="14" Foreground="{StaticResource TextMutedBrush}"
                           VerticalAlignment="Center" HorizontalAlignment="Left"
                           Margin="11,0,0,0" IsHitTestVisible="False"/>
                <TextBlock Text="Search logs…" Foreground="{StaticResource TextMutedBrush}"
                           FontFamily="{StaticResource FontText}" FontSize="14"
                           VerticalAlignment="Center" HorizontalAlignment="Left"
                           Margin="32,0,0,0" IsHitTestVisible="False"
                           Visibility="{Binding SearchText, Converter={StaticResource StrToVis}, ConverterParameter=invert}"/>
            </Grid>

            <!-- level chips + debug/noise + wrap + clear -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <ToggleButton Style="{StaticResource Chip}" Content="Inf" ToolTip="Show info lines"
                              IsChecked="{Binding ShowInf}" Margin="0,0,6,0"/>
                <ToggleButton Style="{StaticResource Chip}" Content="Wrn" ToolTip="Show warnings"
                              IsChecked="{Binding ShowWrn}" Margin="0,0,6,0"/>
                <ToggleButton Style="{StaticResource Chip}" Content="Err" ToolTip="Show errors"
                              IsChecked="{Binding ShowErr}" Margin="0,0,6,0"/>
                <ToggleButton Style="{StaticResource Chip}" Content="Debug" ToolTip="Show debug / verbose lines"
                              IsChecked="{Binding ShowDebug}" Margin="0,0,6,0"/>
                <ToggleButton Style="{StaticResource Chip}" Content="Noise" ToolTip="Show routine sync-layer noise"
                              IsChecked="{Binding ShowNoise}" Margin="0,0,6,0"/>
                <ToggleButton Style="{StaticResource Chip}" Content="Wrap" ToolTip="Wrap long lines"
                              IsChecked="{Binding WrapText}" Margin="0,0,6,0"/>
                <Button Style="{StaticResource Btn.Subtle}" local:Ui.Glyph="{StaticResource Icon.Clear}"
                        ToolTip="Clear the on-screen log" Command="{Binding ClearCommand}"/>
            </StackPanel>
        </Grid>

        <!-- ===================== LOG WELL ===================== -->
        <Border Grid.Row="1" Style="{StaticResource Well}">
            <Grid>
                <ListBox x:Name="LogList" Margin="6,6,4,6"
                         Background="Transparent" BorderThickness="0"
                         ItemsSource="{Binding LinesView}"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.CanContentScroll="True"
                         VirtualizingStackPanel.IsVirtualizing="True"
                         VirtualizingStackPanel.VirtualizationMode="Recycling"
                         HorizontalContentAlignment="Stretch">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="10,1"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Text}" Foreground="{Binding Brush}"
                                       FontFamily="{StaticResource FontMono}" FontSize="{StaticResource Size.Mono}"
                                       TextWrapping="{Binding DataContext.WrapText, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource BoolToWrap}}"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- empty state (reflects the filtered view via ListBox.HasItems) -->
                <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding EmptyHint}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                           Visibility="{Binding HasItems, ElementName=LogList, Converter={StaticResource BoolToVis}, ConverterParameter=invert}"/>

                <!-- floating "jump to latest" pill (shown by code-behind when scrolled up) -->
                <Button x:Name="JumpPill" Style="{StaticResource Btn.Secondary}"
                        Content="Jump to latest" local:Ui.Glyph="{StaticResource Icon.Down}"
                        HorizontalAlignment="Right" VerticalAlignment="Bottom"
                        Margin="0,0,18,16" Visibility="Collapsed" Click="JumpPill_Click">
                    <Button.Effect>
                        <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.55" Color="#000000"/>
                    </Button.Effect>
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>
